# Independently authored; native grammar restricts temporal precision to integer literals.
# Source revisions: tests/sql/corpus/reference-sources.json.

case date-calls valid <<SQL
SELECT CURDATE(), UTC_DATE();
SQL

case time-calls valid <<SQL
SELECT CURTIME(), CURTIME(3), UTC_TIME(), UTC_TIME(6);
SQL

case utc-bare valid <<SQL
SELECT UTC_DATE, UTC_TIME, UTC_TIMESTAMP;
SQL

case timestamp-calls valid <<SQL
SELECT UTC_TIMESTAMP(), UTC_TIMESTAMP(6), NOW();
SQL

case qualified-columns valid <<SQL
SELECT t.curdate, t.curtime, t.now FROM audit_clock t;
SQL

case quoted-columns valid <<SQL
SELECT `curdate`, `curtime`, `now` FROM audit_clock;
SQL

case local-bare-identifiers valid <<SQL
SELECT curdate, curtime, now FROM audit_clock;
SQL

case curtime-negative syntax-error ExpectedToken <<SQL
SELECT CURTIME(-1);
SQL

case curtime-fractional syntax-error ExpectedToken <<SQL
SELECT CURTIME(1.0);
SQL

case curtime-string syntax-error ExpectedToken <<SQL
SELECT CURTIME('1');
SQL

case curtime-null syntax-error ExpectedToken <<SQL
SELECT CURTIME(NULL);
SQL

case curtime-expression syntax-error ExpectedToken <<SQL
SELECT CURTIME(1+1);
SQL

case curtime-too-many syntax-error ExpectedToken <<SQL
SELECT CURTIME(1,2);
SQL

case curtime-range semantic-error InvalidQueryShape <<SQL
SELECT CURTIME(7);
SQL

