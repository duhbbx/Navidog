# Authored window argument grammar; parse/prepare/runtime are separate stages.
# MySQL 8.4.11, MariaDB 11.4.12, TiDB 8.5.3 native PREPARE/SELECT probes.
# OceanBase uses its pinned public mysql-mode productions only.

case basic-buckets valid <<SQL
SELECT NTILE(2) OVER(ORDER BY ABS(17));
SQL

case nth-parenthesized-arithmetic valid <<SQL
SELECT NTH_VALUE(17,(1+1)) OVER(ORDER BY ABS(17));
SQL

case ntile-empty syntax-error ExpectedToken <<SQL
SELECT NTILE() OVER();
SQL

case ntile-extra-argument syntax-error ExpectedToken <<SQL
SELECT NTILE(1,2) OVER();
SQL

case nth-missing-position syntax-error ExpectedToken <<SQL
SELECT NTH_VALUE(17) OVER();
SQL

case ntile-all syntax-error ExpectedToken <<SQL
SELECT NTILE(ALL 1) OVER();
SQL

case lag-empty syntax-error ExpectedToken <<SQL
SELECT LAG() OVER();
SQL

case nth-bare-arithmetic syntax-error ExpectedToken <<SQL
SELECT NTH_VALUE(17,1+1) OVER(ORDER BY ABS(17));
SQL

case ntile-bare-arithmetic syntax-error ExpectedToken <<SQL
SELECT NTILE(1+1) OVER(ORDER BY ABS(17));
SQL

case ntile-parenthesized-arithmetic syntax-error ExpectedToken <<SQL
SELECT NTILE((1+1)) OVER(ORDER BY ABS(17));
SQL

case lag-bare-arithmetic syntax-error ExpectedToken <<SQL
SELECT LAG(17,1+1) OVER(ORDER BY ABS(17));
SQL

case lag-default-argument valid <<SQL
SELECT LAG(17,1,0) OVER(ORDER BY ABS(17));
SQL

case ntile-null syntax-error ExpectedToken <<SQL
SELECT NTILE(NULL) OVER();
SQL

case ntile-signed-literal syntax-error ExpectedToken <<SQL
SELECT NTILE(-1) OVER();
SQL

case ntile-parenthesized-literal syntax-error ExpectedToken <<SQL
SELECT NTILE((1)) OVER();
SQL

case ntile-outside-uint64 syntax-error ExpectedToken <<SQL
SELECT NTILE(18446744073709551616) OVER();
SQL

case lag-string-offset syntax-error ExpectedToken <<SQL
SELECT LAG(17,'1') OVER();
SQL

case lead-numeric-expression syntax-error ExpectedToken <<SQL
SELECT LEAD(17,(1+1)) OVER();
SQL

case ntile-parameter valid <<SQL
SELECT NTILE(?) OVER(ORDER BY ABS(17));
SQL

case stable-integer-requires-routine-local semantic-error UnknownColumn <<SQL
SELECT NTILE(bucket_count) OVER(ORDER BY item_id) FROM (SELECT 2 AS bucket_count,17 AS item_id) AS audit_items;
SQL

case stable-integer-declared-routine-parameter routine-valid <<SQL
CREATE PROCEDURE audit_bucket(IN bucket_count INT)
SELECT NTILE(bucket_count) OVER(ORDER BY item_id)
FROM (SELECT 2 AS bucket_count,17 AS item_id) AS audit_items;
SQL

case stable-integer-does-not-bind-query-column routine-error UnknownColumn <<SQL
CREATE PROCEDURE audit_bucket()
SELECT NTILE(bucket_count) OVER(ORDER BY item_id)
FROM (SELECT 2 AS bucket_count,17 AS item_id) AS audit_items;
SQL
