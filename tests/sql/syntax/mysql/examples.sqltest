case procedure-valid-transaction valid <<SQL
DELIMITER //
CREATE PROCEDURE p_tx(IN a INT, IN b INT)
BEGIN
  DECLARE EXIT HANDLER FOR SQLEXCEPTION
  BEGIN
    ROLLBACK;
  END;
  START TRANSACTION;
  UPDATE accounts SET balance = balance - a WHERE id = 1;
  UPDATE accounts SET balance = balance + b WHERE id = 2;
  COMMIT;
END //
DELIMITER ;
SQL

