CREATE PROCEDURE p_dynamic(IN tbl VARCHAR(64))
BEGIN
  SET @s = CONCAT('SELECT COUNT(*) FROM `', tbl, '`');
  PREPARE stmt FROM @s;
  EXECUTE stmt;
  DEALLOCATE PREPARE stmt;
END //
DELIMITER ;
SQL

case procedure-valid-dynamic-with-param valid <<SQL
DELIMITER //
CREATE PROCEDURE p_dynamic_where(IN min_id INT)
BEGIN
  SET @s = 'SELECT * FROM t WHERE id > ?';
  PREPARE stmt FROM @s;
  SET @a = min_id;
  EXECUTE stmt USING @a;
  DEALLOCATE PREPARE stmt;
END //
DELIMITER ;
SQL

