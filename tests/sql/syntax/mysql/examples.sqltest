case cursor-valid-basic-loop valid <<SQL
DELIMITER //
CREATE PROCEDURE cur_basic()
BEGIN
  DECLARE done INT DEFAULT FALSE;
  DECLARE v_id INT;
  DECLARE v_name VARCHAR(50);
  DECLARE cur CURSOR FOR SELECT id, name FROM users;
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;
  OPEN cur;
  read_loop: LOOP
    FETCH cur INTO v_id, v_name;
    IF done THEN LEAVE read_loop; END IF;
    SELECT v_id, v_name;
  END LOOP;
  CLOSE cur;
END //
DELIMITER ;
SQL

case cursor-valid-two-cursors valid <<SQL
DELIMITER //
CREATE PROCEDURE cur_two()
BEGIN
  DECLARE done INT DEFAULT FALSE;
  DECLARE a CHAR(16);
  DECLARE b, c INT;
  DECLARE cur1 CURSOR FOR SELECT id, data FROM test.t1;
  DECLARE cur2 CURSOR FOR SELECT i FROM test.t2;
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;
  OPEN cur1;
  OPEN cur2;
  read_loop: LOOP
    FETCH cur1 INTO a, b;
    FETCH cur2 INTO c;
    IF done THEN LEAVE read_loop; END IF;
    IF b < c THEN INSERT INTO test.t3 VALUES (a,b);
    ELSE INSERT INTO test.t3 VALUES (a,c);
    END IF;
  END LOOP;
  CLOSE cur1;
  CLOSE cur2;
END //
DELIMITER ;
SQL

case cursor-valid-while-loop valid <<SQL
DELIMITER //
CREATE PROCEDURE cur_while()
BEGIN
  DECLARE v_done INT DEFAULT 0;
  DECLARE v_val INT;
  DECLARE cur CURSOR FOR SELECT val FROM t1;
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_done = 1;
  OPEN cur;
  WHILE v_done = 0 DO
    FETCH cur INTO v_val;
    IF v_done = 0 THEN
      INSERT INTO t2 VALUES (v_val);
    END IF;
  END WHILE;
  CLOSE cur;
END //
DELIMITER ;
SQL

case cursor-valid-repeat-loop valid <<SQL
DELIMITER //
CREATE PROCEDURE cur_repeat()
BEGIN
  DECLARE v_done INT DEFAULT 0;
  DECLARE v_id INT;
  DECLARE cur CURSOR FOR SELECT id FROM source_table;
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_done = 1;
  OPEN cur;
  REPEAT
    FETCH cur INTO v_id;
    IF v_done = 0 THEN
      UPDATE target_table SET flag = 1 WHERE id = v_id;
    END IF;
  UNTIL v_done = 1 END REPEAT;
  CLOSE cur;
END //
DELIMITER ;
SQL

case cursor-valid-aggregate-accumulate valid <<SQL
DELIMITER //
CREATE PROCEDURE cur_sum(OUT total DECIMAL(10,2))
BEGIN
  DECLARE v_done INT DEFAULT 0;
  DECLARE v_amount DECIMAL(10,2);
  DECLARE cur CURSOR FOR SELECT amount FROM orders WHERE status = 'paid';
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_done = 1;
  SET total = 0;
  OPEN cur;
  read_loop: LOOP
    FETCH cur INTO v_amount;
    IF v_done THEN LEAVE read_loop; END IF;
    SET total = total + v_amount;
  END LOOP;
  CLOSE cur;
END //
DELIMITER ;
SQL

case cursor-valid-conditional-skip valid <<SQL
DELIMITER //
CREATE PROCEDURE cur_skip_even()
BEGIN
  DECLARE v_done INT DEFAULT 0;
  DECLARE v_num INT;
  DECLARE cur CURSOR FOR SELECT num FROM numbers;
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_done = 1;
  OPEN cur;
  read_loop: LOOP
    FETCH cur INTO v_num;
    IF v_done THEN LEAVE read_loop; END IF;
    IF v_num % 2 = 0 THEN ITERATE read_loop; END IF;
    INSERT INTO odd_numbers VALUES (v_num);
  END LOOP;
  CLOSE cur;
END //
DELIMITER ;
SQL

case cursor-valid-nested-block valid <<SQL
DELIMITER //
CREATE PROCEDURE cur_nested()
BEGIN
  DECLARE v_done INT DEFAULT 0;
  DECLARE v_id INT;
  DECLARE cur CURSOR FOR SELECT id FROM t1;
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_done = 1;
  OPEN cur;
  outer_loop: LOOP
    FETCH cur INTO v_id;
    IF v_done THEN LEAVE outer_loop; END IF;
    BEGIN
      DECLARE v_cnt INT;
      SELECT COUNT(*) INTO v_cnt FROM t2 WHERE ref_id = v_id;
      IF v_cnt > 0 THEN
        INSERT INTO t3 VALUES (v_id, v_cnt);
      END IF;
    END;
  END LOOP;
  CLOSE cur;
END //
DELIMITER ;
SQL

case cursor-valid-with-transaction valid <<SQL
DELIMITER //
CREATE PROCEDURE cur_tx()
BEGIN
  DECLARE v_done INT DEFAULT 0;
  DECLARE v_id INT;
  DECLARE cur CURSOR FOR SELECT id FROM pending_orders;
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_done = 1;
  DECLARE EXIT HANDLER FOR SQLEXCEPTION ROLLBACK;
  START TRANSACTION;
  OPEN cur;
  read_loop: LOOP
    FETCH cur INTO v_id;
    IF v_done THEN LEAVE read_loop; END IF;
    UPDATE orders SET status = 'processed' WHERE id = v_id;
    INSERT INTO order_log (order_id, action) VALUES (v_id, 'processed');
  END LOOP;
  CLOSE cur;
  COMMIT;
END //
DELIMITER ;
SQL

case cursor-valid-fetch-after-done routine-runtime <<SQL
DELIMITER //
CREATE PROCEDURE cur_fetch_after_done()
BEGIN
  DECLARE v_done INT DEFAULT 0;
  DECLARE v_id INT;
  DECLARE cur CURSOR FOR SELECT id FROM t1;
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_done = 1;
  OPEN cur;
  read_loop: LOOP
    FETCH cur INTO v_id;
    IF v_done THEN
      SELECT 'cursor exhausted' AS msg;
      LEAVE read_loop;
    END IF;
  END LOOP;
  CLOSE cur;
  FETCH cur INTO v_id;
END //
DELIMITER ;
SQL

