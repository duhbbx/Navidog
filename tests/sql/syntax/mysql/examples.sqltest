case procedure-valid-while-loop valid <<SQL
DELIMITER //
CREATE PROCEDURE p_while(IN n INT, OUT total INT)
BEGIN
  DECLARE i INT DEFAULT 0;
  SET total = 0;
  WHILE i < n DO
    SET total = total + i;
    SET i = i + 1;
  END WHILE;
END //
DELIMITER ;
SQL

case procedure-valid-repeat-loop valid <<SQL
