case procedure-valid-get-diagnostics valid <<SQL
DELIMITER //
CREATE PROCEDURE do_insert(value INT)
BEGIN
  DECLARE code CHAR(5) DEFAULT '00000';
  DECLARE msg TEXT;
  DECLARE nrows INT;
  DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
  BEGIN
    GET DIAGNOSTICS CONDITION 1 code = RETURNED_SQLSTATE, msg = MESSAGE_TEXT;
  END;
  INSERT INTO t1 VALUES (value);
  GET DIAGNOSTICS nrows = ROW_COUNT;
  SELECT code, msg, nrows;
END //
DELIMITER ;
SQL

case get-diagnostics-locals-and-stacked routine-valid <<SQL
CREATE PROCEDURE p(IN p_index INT) BEGIN
  DECLARE state_value CHAR(5);
  DECLARE EXIT HANDLER FOR SQLEXCEPTION
  BEGIN
    GET STACKED DIAGNOSTICS CONDITION p_index state_value=RETURNED_SQLSTATE, @err=MYSQL_ERRNO;
  END;
  GET CURRENT DIAGNOSTICS @count=NUMBER;
END;
SQL

