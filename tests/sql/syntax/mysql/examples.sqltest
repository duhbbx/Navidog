case create-function-valid-multi-statement valid <<SQL
DELIMITER $$
CREATE FUNCTION f_get_quantity(_id INT) RETURNS INT READS SQL DATA
BEGIN
    IF _id > 0 THEN
        RETURN (SELECT SUM(col_quantity) FROM book WHERE id_publisher = _id);
    ELSE
        RETURN (SELECT SUM(col_quantity) FROM book);
    END IF;
END$$
DELIMITER ;
SQL

case create-function-valid-if-elseif valid <<SQL
DELIMITER $$
CREATE FUNCTION cleanstr(string1 VARCHAR(60)) RETURNS VARCHAR(60) DETERMINISTIC
BEGIN
    IF LOWER(string1) IN ('cabo verde', 'cambodia', 'cameroon') THEN
        RETURN string1;
    ELSEIF REGEXP_LIKE(string1, '^ca', 'i') = 1 THEN
        RETURN string1;
    ELSE
        RETURN string1;
    END IF;
END$$
DELIMITER ;
SQL

