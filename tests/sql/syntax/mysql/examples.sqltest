DELIMITER //
CREATE PROCEDURE p_nested()
BEGIN
  DECLARE x INT DEFAULT 1;
  outer_blk: BEGIN
    DECLARE y INT DEFAULT 2;
    inner_blk: BEGIN
      DECLARE z INT DEFAULT 3;
      SELECT x + y + z;
    END inner_blk;
  END outer_blk;
END //
DELIMITER ;
SQL

case procedure-valid-iterate valid <<SQL
DELIMITER //
CREATE PROCEDURE p_iterate(IN n INT)
BEGIN
  DECLARE i INT DEFAULT 0;
  DECLARE sum INT DEFAULT 0;
  myloop: LOOP
    SET i = i + 1;
    IF i > n THEN LEAVE myloop; END IF;
    IF i % 2 = 0 THEN ITERATE myloop; END IF;
    SET sum = sum + i;
  END LOOP;
  SELECT sum;
END //
DELIMITER ;
SQL

case procedure-valid-recursion valid <<SQL
DELIMITER //
CREATE PROCEDURE p_recursive(IN n INT, OUT result INT)
BEGIN
  IF n <= 1 THEN
    SET result = 1;
  ELSE
    CALL p_recursive(n - 1, result);
    SET result = result * n;
  END IF;
END //
DELIMITER ;
SQL

case procedure-valid-signal valid <<SQL
DELIMITER //
CREATE PROCEDURE p_signal(IN x INT)
BEGIN
  IF x < 0 THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'negative not allowed';
  END IF;
  SELECT x;
END //
DELIMITER ;
SQL

