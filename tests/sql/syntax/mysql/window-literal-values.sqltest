# Independently authored native execution restrictions; these are not syntax errors.

case ntile-zero semantic-error InvalidQueryShape <<SQL
SELECT NTILE(0) OVER(ORDER BY ABS(17));
SQL

case nth-zero semantic-error InvalidQueryShape <<SQL
SELECT NTH_VALUE(17,0) OVER(ORDER BY ABS(17));
SQL

case nth-negative semantic-error InvalidQueryShape <<SQL
SELECT NTH_VALUE(17,-1) OVER(ORDER BY ABS(17));
SQL

case nth-null semantic-error InvalidQueryShape <<SQL
SELECT NTH_VALUE(17,NULL) OVER(ORDER BY ABS(17));
SQL

case nth-decimal semantic-error InvalidQueryShape <<SQL
SELECT NTH_VALUE(17,1.0) OVER(ORDER BY ABS(17));
SQL

case nth-floating semantic-error InvalidQueryShape <<SQL
SELECT NTH_VALUE(17,1e0) OVER(ORDER BY ABS(17));
SQL

case nth-string semantic-error InvalidQueryShape <<SQL
SELECT NTH_VALUE(17,'1') OVER(ORDER BY ABS(17));
SQL

case nth-query-column semantic-error InvalidQueryShape <<SQL
SELECT NTH_VALUE(17,item_id) OVER(ORDER BY item_id) FROM (SELECT 1 AS item_id) AS audit_items;
SQL

case ntile-execution-max valid <<SQL
SELECT NTILE(9223372036854775807) OVER(ORDER BY ABS(17));
SQL

case ntile-above-signed-execution-max semantic-error InvalidQueryShape <<SQL
SELECT NTILE(9223372036854775808) OVER(ORDER BY ABS(17));
SQL

case nth_value-execution-max valid <<SQL
SELECT NTH_VALUE(17,9223372036854775807) OVER(ORDER BY ABS(17));
SQL

case nth_value-above-signed-execution-max semantic-error InvalidQueryShape <<SQL
SELECT NTH_VALUE(17,9223372036854775808) OVER(ORDER BY ABS(17));
SQL

case lag-execution-max valid <<SQL
SELECT LAG(17,9223372036854775807) OVER(ORDER BY ABS(17));
SQL

case lag-above-signed-execution-max semantic-error InvalidQueryShape <<SQL
SELECT LAG(17,9223372036854775808) OVER(ORDER BY ABS(17));
SQL

case lead-execution-max valid <<SQL
SELECT LEAD(17,9223372036854775807) OVER(ORDER BY ABS(17));
SQL

case lead-above-signed-execution-max semantic-error InvalidQueryShape <<SQL
SELECT LEAD(17,9223372036854775808) OVER(ORDER BY ABS(17));
SQL

case nth_value-boolean-true valid <<SQL
SELECT NTH_VALUE(17,TRUE) OVER(ORDER BY ABS(17));
SQL

case nth_value-boolean-false semantic-error InvalidQueryShape <<SQL
SELECT NTH_VALUE(17,FALSE) OVER(ORDER BY ABS(17));
SQL

case nth_value-date-type semantic-error InvalidQueryShape <<SQL
SELECT NTH_VALUE(17,CURRENT_DATE) OVER(ORDER BY ABS(17));
SQL

case nth_value-user-string-type semantic-error InvalidQueryShape <<SQL
SELECT NTH_VALUE(17,CURRENT_USER) OVER(ORDER BY ABS(17));
SQL
