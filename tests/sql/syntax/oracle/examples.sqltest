case procedure-undeclared-variable routine-error UnknownColumn <<SQL
CREATE PROCEDURE p AS
BEGIN
  undeclared_variable := 1;
END;
SQL

case table-number valid <<SQL
CREATE TABLE inventory (id NUMBER(10) PRIMARY KEY, name VARCHAR2(100));
SQL

case pivot-aliased-output valid <<SQL
SELECT p.grp, p.a_total FROM (SELECT 1 grp, 3 amount, 'A' status_code FROM SYS.DUAL)
  PIVOT (SUM(amount) AS total FOR status_code IN ('A' AS a, 'B' AS b)) p;
SQL
