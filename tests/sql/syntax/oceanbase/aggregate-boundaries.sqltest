case json-array-one valid <<SQL
SELECT JSON_ARRAYAGG(17);
SQL

case json-array-two syntax-error ExpectedToken <<SQL
SELECT JSON_ARRAYAGG(17,23);
SQL

case json-array-distinct valid <<SQL
