case bit-in-where semantic-error InvalidQueryShape <<SQL
SELECT item_id FROM audit_items WHERE BIT_AND(item_id)>0;
SQL

case json-nested-aggregate semantic-error InvalidQueryShape <<SQL
SELECT SUM(JSON_ARRAYAGG(item_id)) FROM audit_items;
SQL
