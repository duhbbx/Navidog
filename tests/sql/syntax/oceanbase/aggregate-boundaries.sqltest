# Independently authored; native aggregate signatures and DISTINCT modifiers differ among MySQL-family products.

case bit_and-argument valid <<SQL
SELECT BIT_AND(17);
SQL

case bit_and-all valid <<SQL
SELECT BIT_AND(ALL 17);
SQL

case bit_and-distinct syntax-error ExpectedToken <<SQL
SELECT BIT_AND(DISTINCT 17);
SQL

case bit_and-empty syntax-error ExpectedToken <<SQL
SELECT BIT_AND();
SQL

case bit_and-two syntax-error ExpectedToken <<SQL
SELECT BIT_AND(17,23);
SQL

case bit_and-star syntax-error ExpectedToken <<SQL
SELECT BIT_AND(*);
SQL

case bit_or-argument valid <<SQL
SELECT BIT_OR(17);
SQL

case bit_or-all valid <<SQL
SELECT BIT_OR(ALL 17);
SQL

case bit_or-distinct syntax-error ExpectedToken <<SQL
