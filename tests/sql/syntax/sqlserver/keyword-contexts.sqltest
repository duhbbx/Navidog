# Independently authored T-SQL cases; ScriptDOM TSql160 and official docs checked.
# Unsupported cases retain explicit owning-model/scope gaps.

case fillfactor-quoted-column valid <<SQL
SELECT [FILLFACTOR] FROM audit_items;
SQL

case backup-quoted-column valid <<SQL
SELECT [BACKUP] FROM audit_items;
SQL

case public-quoted-column valid <<SQL
