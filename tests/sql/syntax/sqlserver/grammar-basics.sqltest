# Independently authored SQL grammar regression matrix, 2026-11-27.
# Grammar families: queries, expressions, joins, DML, DDL; matched valid/invalid boundaries.
# Reference: https://learn.microsoft.com/en-us/sql/t-sql/statements/statements
# Fixed grammar source revisions and collection procedure: docs/sql-grammar-corpus.md.
# No database connection or upstream test harness is required.

case query-case-simple valid <<SQL
SELECT CASE 3 WHEN 1 THEN 'one' WHEN 3 THEN 'three' ELSE 'other' END ;
SQL

case query-case-search valid <<SQL
SELECT CASE WHEN 3 BETWEEN 1 AND 4 THEN 9 ELSE 0 END ;
SQL

case query-coalesce valid <<SQL
SELECT COALESCE(NULL, 3), NULLIF(4, 4) ;
SQL

case query-in-list valid <<SQL
SELECT 3 WHERE 3 IN (1, 3, 5);
SQL

case query-exists valid <<SQL
SELECT a.id FROM audit_items a WHERE EXISTS (SELECT 1 FROM audit_items b WHERE a.id = b.id);
SQL

case query-correlated-not-exists valid <<SQL
SELECT a.id FROM audit_items a WHERE NOT EXISTS (SELECT 1 FROM audit_events b WHERE b.item_id = a.id);
SQL

case query-between valid <<SQL
SELECT id FROM audit_items WHERE amount NOT BETWEEN 3 AND 11;
SQL

case query-like valid <<SQL
SELECT id FROM audit_items WHERE label NOT LIKE 'x%';
SQL

case query-group-having valid <<SQL
SELECT category, COUNT(*) FROM audit_items GROUP BY category HAVING COUNT(*) > 2;
SQL

case query-group-null valid <<SQL
SELECT category, SUM(amount) FROM audit_items WHERE amount IS NOT NULL GROUP BY category;
SQL

case query-join-using-alias valid <<SQL
SELECT a.id, b.label FROM audit_items a LEFT JOIN audit_labels b ON a.label_id=b.id;
SQL

case query-full-expression-join valid <<SQL
SELECT a.id FROM audit_items a INNER JOIN audit_events b ON a.id=b.item_id AND b.id > 2;
SQL

case query-union-distinct valid <<SQL
SELECT id FROM audit_items UNION SELECT item_id FROM audit_events;
SQL

case query-union-all-order valid <<SQL
SELECT id FROM audit_items UNION ALL SELECT item_id FROM audit_events ORDER BY 1;
SQL

case query-cte-columns valid <<SQL
WITH q(id) AS (SELECT id FROM audit_items) SELECT id FROM q;
SQL

case query-order-expression valid <<SQL
SELECT amount FROM audit_items ORDER BY amount + 1 DESC, id ASC;
SQL

case dml-insert-multirow valid <<SQL
INSERT INTO audit_items(id,label) VALUES(1,'alpha'),(2,'beta');
SQL

case dml-insert-select valid <<SQL
INSERT INTO audit_archive(id) SELECT id FROM audit_items WHERE amount > 0;
SQL

case dml-update-scalar valid <<SQL
UPDATE audit_items SET amount=amount+1,label='updated' WHERE id=3;
SQL

case dml-delete-exists valid <<SQL
DELETE FROM audit_items WHERE EXISTS(SELECT 1 FROM audit_archive a WHERE a.id=audit_items.id);
SQL

case ddl-table-default-check valid <<SQL
CREATE TABLE audit_items(id INTEGER NOT NULL, amount DECIMAL(10,2) DEFAULT 0, CHECK(amount>=0));
SQL

case ddl-table-primary-key valid <<SQL
CREATE TABLE audit_items(id INTEGER PRIMARY KEY, label VARCHAR(40));
SQL

case ddl-table-unique valid <<SQL
CREATE TABLE audit_items(id INTEGER, label VARCHAR(40), CONSTRAINT audit_unique UNIQUE(id,label));
SQL

case ddl-table-foreign-key valid <<SQL
CREATE TABLE audit_events(id INTEGER, item_id INTEGER, FOREIGN KEY(item_id) REFERENCES audit_items(id));
SQL

case ddl-index valid <<SQL
CREATE INDEX audit_amount ON audit_items(amount);
SQL

case ddl-view-columns valid <<SQL
CREATE VIEW audit_view(item_id,total) AS SELECT id,amount FROM audit_items;
SQL

case bad-select-missing-expression syntax-error <<SQL
SELECT FROM audit_items;
SQL

case bad-select-missing-from-name syntax-error <<SQL
SELECT id FROM;
SQL

case bad-select-trailing-comma syntax-error <<SQL
SELECT id, FROM audit_items;
SQL

case bad-select-missing-operand syntax-error <<SQL
SELECT amount + FROM audit_items;
SQL

case bad-select-unclosed-parenthesis syntax-error <<SQL
SELECT (amount + 1 FROM audit_items;
SQL

case bad-select-missing-join-on syntax-error <<SQL
SELECT a.id FROM audit_items a INNER JOIN audit_events b ON;
SQL

case bad-select-between-missing-and syntax-error <<SQL
SELECT id FROM audit_items WHERE id BETWEEN 1 4;
SQL

case bad-select-in-trailing-comma syntax-error <<SQL
SELECT id FROM audit_items WHERE id IN (1,);
SQL

case bad-select-case-no-end syntax-error <<SQL
SELECT CASE WHEN id=1 THEN 2 ELSE 3 FROM audit_items;
SQL

case bad-select-case-no-then syntax-error <<SQL
SELECT CASE WHEN id=1 2 END FROM audit_items;
SQL

case bad-select-order-empty syntax-error <<SQL
SELECT id FROM audit_items ORDER BY;
SQL

case bad-select-group-empty syntax-error <<SQL
SELECT id FROM audit_items GROUP BY;
SQL

case bad-insert-empty-values syntax-error <<SQL
INSERT INTO audit_items(id) VALUES();
SQL

case bad-insert-missing-target syntax-error <<SQL
INSERT INTO(id) VALUES(1);
SQL

case bad-update-empty-set syntax-error <<SQL
UPDATE audit_items SET WHERE id=1;
SQL

case bad-update-missing-equals syntax-error <<SQL
UPDATE audit_items SET amount 4;
SQL

case bad-delete-empty-from syntax-error <<SQL
DELETE FROM WHERE id=1;
SQL

case bad-create-table-empty-column-type syntax-error <<SQL
CREATE TABLE audit_items(id);
SQL

case bad-create-index-no-column syntax-error <<SQL
CREATE INDEX audit_idx ON audit_items();
SQL

case bad-create-view-no-query syntax-error <<SQL
CREATE VIEW audit_view AS;
SQL
