option(NAVIDOG_WITH_CLICKHOUSE "Build the official ClickHouse C++ adapter" OFF)
set(NAVIDOG_DUCKDB_ROOT "" CACHE PATH "DuckDB official C SDK folder")
set(NAVIDOG_MONGOC_ROOT "" CACHE PATH "MongoDB official C SDK CMake prefix")
if(NAVIDOG_WIN7 OR NAVIDOG_HARMONYOS)
    return()
endif()

if(NAVIDOG_DUCKDB_ROOT)
    find_path(NAVIDOG_DUCKDB_INCLUDE duckdb.h HINTS "${NAVIDOG_DUCKDB_ROOT}" PATH_SUFFIXES include NO_DEFAULT_PATH REQUIRED)
    find_library(NAVIDOG_DUCKDB_LIBRARY NAMES duckdb HINTS "${NAVIDOG_DUCKDB_ROOT}" PATH_SUFFIXES lib NO_DEFAULT_PATH REQUIRED)
    target_sources(navidog_core PRIVATE src/drivers/duckdb.cpp)
    target_include_directories(navidog_core PRIVATE "${NAVIDOG_DUCKDB_INCLUDE}")
    target_link_libraries(navidog_core PRIVATE "${NAVIDOG_DUCKDB_LIBRARY}")
    target_compile_definitions(navidog_core PRIVATE NAVIDOG_HAS_DUCKDB=1)
endif()

if(NAVIDOG_MONGOC_ROOT)
    find_package(mongoc 2.0 CONFIG REQUIRED HINTS "${NAVIDOG_MONGOC_ROOT}")
else()
    find_package(mongoc 2.0 CONFIG QUIET)
endif()
if(TARGET mongoc::shared)
    target_sources(navidog_core PRIVATE src/drivers/mongodb.cpp)
    target_link_libraries(navidog_core PRIVATE mongoc::shared)
    target_compile_definitions(navidog_core PRIVATE NAVIDOG_HAS_MONGODB=1)
endif()

if(NAVIDOG_WITH_CLICKHOUSE)
    include(FetchContent)
    find_package(OpenSSL QUIET)
    set(WITH_OPENSSL ${OpenSSL_FOUND})
    set(BUILD_TESTS OFF)
    set(BUILD_BENCHMARK OFF)
    FetchContent_Declare(navidog_clickhouse
        URL https://codeload.github.com/ClickHouse/clickhouse-cpp/tar.gz/refs/tags/v2.6.2
        URL_HASH SHA256=bac497857759e991fa4e1638bccf936cb36d10ad79273695a570272cc4891428)
    FetchContent_MakeAvailable(navidog_clickhouse)
    target_sources(navidog_core PRIVATE src/drivers/clickhouse.cpp)
    target_link_libraries(navidog_core PRIVATE clickhouse-cpp-lib)
    target_compile_definitions(navidog_core PRIVATE NAVIDOG_HAS_CLICKHOUSE=1)
    if(OpenSSL_FOUND)
        target_compile_definitions(navidog_core PRIVATE NAVIDOG_CLICKHOUSE_TLS=1)
    endif()
endif()
